# Supabase seed / migration helpers
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Optional fallback accepted by scripts/seed-supabase.ts
# VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Turso CMS fallback
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional API config
CMS_PROVIDER_TIMEOUT_MS=3000
CMS_API_ALLOW_ORIGIN=https://your-public-domain.com
CMS_REPOSITORY_PROVIDER_ORDER=supabase,turso,static
CMS_MEDIA_MANIFEST_PATH=data/fallback/media-manifest.json
CMS_PUBLIC_ASSET_BASE_URL=https://your-public-domain.com/cms-assets

# Use true when the public site should call the CMS Repository or Supabase directly.
VITE_ALLOW_REMOTE_PUBLIC_DATA=true

# Supabase quota guard. Fill these from Supabase Usage before running npm run supabase:quota-guard.
SUPABASE_QUOTA_GUARD_THRESHOLD=0.8
# SUPABASE_EGRESS_USED_GB=0
# SUPABASE_EGRESS_QUOTA_GB=5
# SUPABASE_CACHED_EGRESS_USED_GB=0
# SUPABASE_CACHED_EGRESS_QUOTA_GB=5
# SUPABASE_STORAGE_USED_GB=0
# SUPABASE_STORAGE_QUOTA_GB=1

# Supabase Storage maintenance. Audit is dry-run; cleanup requires npm run cms:storage-cleanup.
SUPABASE_CLEANUP_MIN_AGE_DAYS=7
SUPABASE_CLEANUP_BUCKETS=portfolio-public,portfolio-private

# Optional: used to generate absolute sharing/canonical URLs for blog articles
# VITE_PUBLIC_SITE_URL=https://your-public-domain.com
